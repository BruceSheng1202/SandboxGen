# Harness container: runs the controller and model client. The production
# wrapper dispatches analyze_sample operations to isolated analysis sidecars.
# Detonation is delegated to SIBLING containers spawned
# through the host podman socket (podman-remote), so each detonation keeps its
# own --network none isolation (four walls, see sandbox_infra/qemu/README.md).
#
# This container HAS outbound network because the LLM API needs it; the sample
# never runs here (it runs in the isolated qemu guest with restrict=on), so a
# network-carrying harness container does not give the sample egress.
FROM docker.io/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        file p7zip-full unzip podman-remote ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/locks/runtime.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt
WORKDIR /work
ENV SANDBOXGEN_PODMAN="podman-remote --url unix:///run/podman/podman.sock" \
    PYTHONUNBUFFERED=1
